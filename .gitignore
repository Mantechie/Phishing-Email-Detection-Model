# ─────────────────────────────────────────────────────────────────
# .gitignore – Phishing Email Detector
# ─────────────────────────────────────────────────────────────────

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Trained model artifacts (large binary files)
models/*.pkl
models/*.joblib

# Generated reports
reports/*.png
reports/*.pdf

# Logs
logs/*.log
logs/*.txt

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment files
.env
.env.local

# Distribution / packaging
dist/
build/
*.egg-info/
